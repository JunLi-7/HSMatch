# 上线配置模板：复制本文件为 .env 并按需修改（.env 已被 .gitignore 忽略，不会进仓库）

# 【上线必改】JWT 签名密钥，请设为强随机值（不要用默认值）
# 生成命令：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# 服务端口（内网穿透 / 云部署时使用，默认 3001）
PORT=3001

# 数据库文件路径（默认 ./data/match.db，一般不用改；SQLite 文件请确保持久化）
# DATABASE_PATH=./data/match.db
