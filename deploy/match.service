# systemd 单元：让 Node 服务开机自启、崩溃/重启后自动拉起
# 用法（服务器上，项目已放在 /opt/hs-match）：
#   1) sudo cp /opt/hs-match/deploy/match.service /etc/systemd/system/match.service
#   2) sudo systemctl daemon-reload
#   3) sudo systemctl enable --now match
#   4) 查看状态：sudo systemctl status match      实时日志：sudo journalctl -u match -f
[Unit]
Description=Hearthstone Match System (Node)
After=network.target

[Service]
Type=simple
# 项目绝对路径（本次部署固定为 /opt/hs-match）
WorkingDirectory=/opt/hs-match
ExecStart=/usr/bin/bash /opt/hs-match/deploy/start.sh
Restart=on-failure
RestartSec=3
# 省略 User= 时 systemd 默认以 root 运行（个人单机服务器最简单，SQLite 文件读写不会有权限问题）。
# 想更安全可改专用用户：先 `useradd -r -s /usr/sbin/nologin hs && chown -R hs:hs /opt/hs-match`，再在下面加 User=hs
Environment=PORT=3001
Environment=NODE_ENV=production
# JWT 密钥：建议写在 /opt/hs-match/.env（应用启动会自动读取），内容形如 JWT_SECRET=一长串随机值
# 生成：openssl rand -hex 32
EnvironmentFile=-/opt/hs-match/.env

[Install]
WantedBy=multi-user.target
